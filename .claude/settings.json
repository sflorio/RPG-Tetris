{
  "env": {
    "GODOT": "C:\\Godot_v4.7.2-stable_win64_console.exe"
  },
  "permissions": {
    "allow": [
      "Bash(python tools/godot.py *)",
      "Bash(python tools/check_maps.py*)",
      "Bash(python tools/render_oryx.py *)",
      "Bash(python tools/render_map.py *)",
      "Bash(python -m gdtoolkit.linter *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_gdscript.py\"",
            "timeout": 120,
            "statusMessage": "Checking GDScript..."
          }
        ]
      }
    ]
  }
}
